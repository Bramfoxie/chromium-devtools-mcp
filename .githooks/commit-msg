#!/bin/sh
. "$(dirname "$0")/lib.sh"

msg=$(sed '/^# -\{24\} >8 -\{24\}$/,$d' "$1" | grep -v '^#')

fail() {
  echo "commit-msg: $1" >&2
  exit 1
}

printf '%s\n' "$msg" | has_attribution && fail "tool attribution is not allowed"
printf '%s\n' "$msg" | has_typography && fail "typographic dashes, quotes, ellipses and emoji are not allowed"

subject=$(printf '%s\n' "$msg" | sed -n '1p')
[ -n "$subject" ] || fail "empty subject"
length=$(printf '%s' "$subject" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')
[ "$length" -le 72 ] || fail "subject is longer than 72 characters"
exit 0
