#!/bin/sh
msg_file="$1"
msg=$(grep -v '^#' "$msg_file")

fail() {
  echo "commit-msg: $1" >&2
  exit 1
}

printf '%s' "$msg" | grep -qiE '^co-authored-by:' && fail "Co-Authored-By trailers are not allowed"
printf '%s' "$msg" | grep -qiE 'generated with|claude code|noreply@anthropic' && fail "tool attribution is not allowed"
printf '%s' "$msg" | grep -q "$(printf '\360\237\244\226')" && fail "emoji attribution is not allowed"
printf '%s' "$msg" | grep -q "$(printf '\342\200\224')\|$(printf '\342\200\223')" && fail "em and en dashes are not allowed"

subject=$(printf '%s' "$msg" | sed -n '1p')
[ -n "$subject" ] || fail "empty subject"
[ ${#subject} -le 72 ] || fail "subject is longer than 72 characters"
exit 0
