#!/bin/sh
. "$(dirname "$0")/lib.sh"

fail() {
  echo "pre-commit: $1" >&2
  exit 1
}

staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRT)
[ -n "$staged" ] || exit 0

printf '%s\n' "$staged" | grep -qE '(^|/)(AGENTS|CLAUDE)\.md$' && fail "AGENTS.md and CLAUDE.md must not be committed"

printf '%s\n' "$staged" | while IFS= read -r f; do
  if git show ":$f" | has_typography; then
    fail "typographic dash, quote, ellipsis or emoji found in $f"
  fi
  case "$f" in .githooks/*) continue ;; esac
  if git show ":$f" | has_attribution; then fail "tool attribution found in $f"; fi
done || exit 1

if [ -f package.json ]; then
  has_script() { node -e "process.exit(require('./package.json').scripts?.['$1'] ? 0 : 1)"; }
  for s in lint typecheck; do
    if has_script "$s"; then
      npm run -s "$s" || fail "npm run $s failed"
    fi
  done
fi
exit 0
