{
  "name": "chromium-devtools-mcp",
  "version": "0.0.2",
  "description": "MCP server that lets AI agents drive your Chromium browser through the DevTools Protocol",
  "license": "MIT",
  "author": "Milana Kustinskaya <me@bramfoxie.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bramfoxie/chromium-devtools-mcp.git"
  },
  "homepage": "https://github.com/Bramfoxie/chromium-devtools-mcp#readme",
  "bugs": {
    "url": "https://github.com/Bramfoxie/chromium-devtools-mcp/issues"
  },
  "type": "module",
  "bin": {
    "chromium-devtools-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "chrome",
    "chromium",
    "devtools",
    "cdp"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "test": "vitest run --passWithNoTests",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
